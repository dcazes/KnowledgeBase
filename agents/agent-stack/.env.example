# Agent Stack — environment variables (TEMPLATE)
# Copy to .env and replace every CHANGE_ME. NEVER commit the real .env.

# ── LLM (free tier via :4000 proxy) ──
OPENAI_API_KEY=CHANGE_ME              # used by Firecrawl + Graphiti MCP (or set FIRECRAWL_LLM_PROVIDER)
FIRECRAWL_LLM_PROVIDER=openai
# LiteLLM free-tier keys (chosen in litellm/config.yaml):
OPENROUTER_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME

# ── Firecrawl subservices ──
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=CHANGE_ME
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Graphiti MCP (FalkorDB bundled) ──
# FALKORDB_URL default bolt://falkordb:6379 (no creds needed for bundled mode)
GRAPHITI_DB_PROVIDER=falkordb

# ── Weaviate ──
WEAVIATE_AUTH=anonymous                # set to apikey + WEAVIATE_API_KEY for prod
WEAVIATE_API_KEY=CHANGE_ME

# ── Optional: reranker module (Weaviate ENABLE_MODULES includes reranker-cohere) ──
COHERE_API_KEY=CHANGE_ME

# ── Ollama (local, 1060) ──
# Pull these after first up:
#   ollama pull nomic-embed-text      # embeddings
#   ollama pull qwen2.5-coder:3b      # tiny local LLM
OLLAMA_HOST=0.0.0.0
